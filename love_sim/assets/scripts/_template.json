      "speech": {"bigFiveProfile": {}, "phonetics": {}, "vocabulary": {}, "dualMode": {"to_stranger": {"overview": "", "example": ""}, "to_close": {"overview": "", "example": ""}}},
      "humanity": {"emotionalRange": "", "attachmentStyle": "", "socialStrategy": ""},
      "agent": {"personalityOverview": "", "chatPersonality": "", "narrativeStyle": "", "emotionalExpression": "", "conflictStrategy": "", "specialBehaviors": []},
      "appearance": {"body": "", "uniform": "", "expression": "", "details": []},
